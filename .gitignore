# Local interpreter selection only. The devcontainer image is Python 3.13,
# devsetup.sh exports UV_PYTHON=3.13, and CI sets the version via the matrix,
# so a tracked pin adds nothing; leave it free for pyenv/local overrides.
.python-version

patch_*
fragdenstaat_de_at_*

# Database dumps (privacy-preserving dev exports and anything like them).
# Generated by scripts/export_dev_db.py; too large and too data-shaped for git.
*.sql
*.sql.zip
*.sql.gz
migrate.log

